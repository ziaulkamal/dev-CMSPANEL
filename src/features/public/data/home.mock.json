    { "id": "c0", "slug": "kopi-gayo-tembus-pasar-eropa", "title": "Kopi Gayo tembus pasar Eropa setelah lolos sertifikasi baru", "excerpt": "Eksportir di Aceh Tengah menyebut permintaan dari Eropa melonjak usai sertifikasi keberlanjutan diterbitkan. Petani berharap harga di tingkat kebun ikut terangkat, meski sebagian masih khawatir soal konsistensi mutu dan biaya logistik dari dataran tinggi Gayo ke pelabuhan ekspor.", "featured_image": "https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=480&q=70", "category": "EKONOMI", "category_color": "#059669", "authors": [{ "display_name": "Rina Wijaya", "avatar": "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&crop=faces&w=96&h=96&q=70" }], "stats": { "views": 42100, "comments": 312, "shares": 1280 }, "published_at": "2026-06-22T08:10:00Z" },
    { "id": "c1", "slug": "konferensi-kelautan-aceh", "title": "Konferensi kelautan di Banda Aceh hasilkan kesepakatan konservasi", "excerpt": "Para delegasi menyepakati langkah perlindungan terumbu karang di perairan Sabang setelah pembahasan maraton hingga larut malam. Kesepakatan mencakup pembatasan zona tangkap dan pendanaan untuk rehabilitasi ekosistem pesisir yang rusak akibat aktivitas berlebih.", "featured_image": "https://images.unsplash.com/photo-1559827260-dc66d52bef19?auto=format&fit=crop&w=480&q=70", "category": "LINGKUNGAN", "category_color": "#059669", "authors": [{ "display_name": "Adi Pratama", "avatar": "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&crop=faces&w=96&h=96&q=70" }], "stats": { "views": 28700, "comments": 184, "shares": 906 }, "published_at": "2026-06-22T07:50:00Z" },
    { "id": "c2", "slug": "hasil-pilkada-aceh", "title": "Hasil Pilkada Aceh picu perdebatan soal angka partisipasi", "excerpt": "Penyelenggara membela hasil rekapitulasi saat sejumlah pihak mempertanyakan tingginya partisipasi di beberapa kabupaten. Pemantau dari kedua kubu meminta audit independen, sementara KIP Aceh menegaskan angka itu konsisten dengan data pemilih dan tren pencoblosan awal.", "featured_image": "https://images.unsplash.com/photo-1540910419892-4a36d2c3266c?auto=format&fit=crop&w=480&q=70", "category": "POLITIK", "category_color": "#e11a33", "authors": [{ "display_name": "Siti Hapsah", "avatar": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&crop=faces&w=96&h=96&q=70" }], "stats": { "views": 51300, "comments": 627, "shares": 2140 }, "published_at": "2026-06-22T07:20:00Z" },
    { "id": "c3", "slug": "umkm-aceh-go-digital", "title": "UMKM Aceh bersiap hadapi gelombang digitalisasi pasar", "excerpt": "Program pendampingan baru akan mengubah cara pelaku usaha kecil di Aceh memasarkan produk, mengelola data pelanggan, dan bersaing lintas daerah. Pemprov menargetkan ribuan UMKM masuk lokapasar tahun ini, meski sebagian pelaku mengeluhkan keterbatasan jaringan internet di pelosok.", "featured_image": "https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&fit=crop&w=480&q=70", "category": "TEKNOLOGI", "category_color": "#0284c7", "authors": [{ "display_name": "Bayu Saputra" }], "stats": { "views": 19800, "comments": 98, "shares": 540 }, "published_at": "2026-06-22T06:55:00Z" },
    { "id": "c4", "slug": "harga-pinang-aceh-melandai", "title": "Harga pinang Aceh melandai seiring pasokan ekspor pulih", "excerpt": "Harga di tingkat pengumpul turun selama tiga pekan beruntun setelah stok membaik dan permintaan ekspor kembali stabil. Pedagang menyebut pelonggaran arus barang di pelabuhan sebagai pendorong utama, namun mengingatkan gangguan cuaca bisa cepat membalik tren.", "featured_image": "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=480&q=70", "category": "EKONOMI", "category_color": "#059669", "authors": [{ "display_name": "Dewi Lestari" }], "stats": { "views": 14200, "comments": 56, "shares": 312 }, "published_at": "2026-06-22T06:30:00Z" },
    { "id": "c5", "slug": "riset-vaksin-unsyiah", "title": "Peneliti Unsyiah laporkan kemajuan uji vaksin tropis", "excerpt": "Hasil awal menunjukkan respons imun yang kuat dengan efek samping minim, memunculkan harapan jalur persetujuan yang lebih cepat. Tim peneliti menegaskan uji skala besar masih diperlukan, tetapi menyebut data awal ini sebagai yang paling menjanjikan sejauh ini.", "featured_image": "https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=480&q=70", "category": "KESEHATAN", "category_color": "#0284c7", "authors": [{ "display_name": "Farah Nuraini" }], "stats": { "views": 33600, "comments": 241, "shares": 1490 }, "published_at": "2026-06-22T05:48:00Z" },
    { "id": "c6", "slug": "persiraja-juara-dramatis", "title": "Persiraja kalahkan juara bertahan di final dramatis", "excerpt": "Gol di menit akhir memastikan kejutan yang tak banyak diprediksi pengamat di laga penentu musim ini. Suporter membanjiri jalanan Banda Aceh untuk merayakan, sementara pelatih menyebut kemenangan ini buah dari persiapan tanpa kenal lelah dan keyakinan tim.", "featured_image": "https://images.unsplash.com/photo-1431324155629-1a6deb1dec8d?auto=format&fit=crop&w=480&q=70", "category": "OLAHRAGA", "category_color": "#f59e00", "authors": [{ "display_name": "Yoga Mahendra" }], "stats": { "views": 47900, "comments": 503, "shares": 1820 }, "published_at": "2026-06-22T05:10:00Z" }
