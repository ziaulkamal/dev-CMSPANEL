# Base URL backend CMS Core (headless REST API). Port dev = 40200 (lihat DEV.md).
VITE_API_BASE_URL=http://localhost:40200/v1

# Base URL publik berkas media (MinIO/S3). Isi HANYA bila backend mengembalikan
# key/path relatif (mis. "media/abc.png"), bukan URL absolut. Contoh MinIO lokal:
# VITE_MEDIA_BASE_URL=http://localhost:40204

# Beranda publik memakai dummy data JSON (visual penuh tanpa backend).
# true → tampilkan contoh; false → ambil dari API. Default dev: true.
VITE_USE_MOCK=false
