# ──────────────────────────────────────────────────────────────────
# CMS Panel — environment PRODUKSI. Salin ke .env.prod lalu sesuaikan.
#
#   cp .env.prod.example .env.prod
#
# PENTING: VITE_API_BASE_URL di-BAKE saat BUILD (bukan runtime). Nilai di
# bawah dipakai oleh compose.prod.yaml sebagai --build-arg. Kalau URL API
# berubah, panel WAJIB di-build ulang (docker compose build).
# ──────────────────────────────────────────────────────────────────

# Ganti <IP-SERVER> dengan IP publik server backend. Sertakan /v1.
VITE_API_BASE_URL=http://<IP-SERVER>/v1
