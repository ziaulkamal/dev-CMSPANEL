# Dockerfile.prod — build produksi multi-stage: bundle Vite (esbuild) lalu Nginx.
# VITE_API_BASE_URL bersifat BUILD-TIME (di-bake ke bundle), kirim via --build-arg.

# ── Stage 1: build bundle statis ──────────────────────────────────
FROM node:22-alpine AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

COPY . .

# URL backend di-inject saat build (default dev). Override di prod.
ARG VITE_API_BASE_URL=http://localhost:3000/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN pnpm run build

# ── Stage 2: serve statis via Nginx ───────────────────────────────
FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
